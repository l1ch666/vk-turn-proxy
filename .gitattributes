* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# The generated license bundle is byte-compared against a fresh run by the
# license-image job. Without a pinned ending it would check out as CRLF on
# Windows and never match a regenerated LF bundle.
THIRD_PARTY_LICENSES/** text eol=lf
